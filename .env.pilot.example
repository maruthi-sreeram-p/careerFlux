# ===========================================================================
# CareerFlux — pilot environment
#
# Copy to `.env` (gitignored) beside docker-compose.yml and fill in real
# values. Every variable below without a default is required: the pilot overlay
# uses the `:?` form, so `docker compose` refuses to start rather than falling
# back to a development credential.
#
# Placeholders only in this file. Never commit a filled-in copy.
# ===========================================================================

# --- Required --------------------------------------------------------------

# Signs every access and refresh token. At least 32 characters.
# The application's built-in fallback is published in this repository and is
# refused outside dev/test, so this must be a real value.
#   openssl rand -base64 48
CAREERFLUX_JWT_SECRET=replace-with-a-generated-secret

# The college's PostgreSQL credentials. The base compose file's password is a
# laptop convenience and must not be reused here.
DATABASE_USERNAME=careerflux
POSTGRES_PASSWORD=replace-with-a-generated-password

# Where the college loads the frontend from, comma-separated. Never '*' —
# credentials are sent with requests and a wildcard would be refused anyway.
#   e.g. https://placements.yourcollege.edu
CAREERFLUX_CORS_ORIGINS=https://replace-with-the-pilot-frontend-origin

# --- First boot only -------------------------------------------------------
#
# Creates the platform operator account, once. Remove both after the first
# successful start so the password stops living in the container environment.

CAREERFLUX_ADMIN_EMAIL=replace-with-an-operator-address
CAREERFLUX_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Rate limiting ---------------------------------------------------------
#
# Ceilings are set in application.yml and are on by default. Set this to false
# ONLY if something in front of the application already does the same job;
# leaving it unset is the correct pilot setting.
#
# The counters live in the backend's memory, so they are a true global limit
# only while exactly one backend instance runs. Adding a second one behind a
# load balancer doubles every ceiling and needs shared state instead.

# CAREERFLUX_RATE_LIMIT_ENABLED=true

# --- Optional --------------------------------------------------------------
#
# A Google AI Studio key. Leaving it empty is a supported mode, not a
# degraded one: resume parsing and match narratives fall back to deterministic
# implementations, and candidate discovery, scoring and eligibility never used
# AI at all. Per-student daily quotas apply either way.

GEMINI_API_KEY=
