# =============================================================================
# CareerFlux environment
#
# Copy to `.env` (which is gitignored) and fill in real values, or export these
# in your shell before starting the backend. Nothing secret belongs in
# application.yml — every sensitive value is read from the environment.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Signing key for access and refresh tokens. Must be at least 32 characters;
# the application refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
CAREERFLUX_JWT_SECRET=replace-me-with-at-least-32-random-characters


# --- AI (optional) ------------------------------------------------------------
#
# A Google AI Studio key for Gemini. Setting it is all that is needed: the
# application detects the key at startup and switches Spring AI on. Leave it
# unset and CareerFlux still runs — resume parsing falls back to a deterministic
# parser and match explanations are written from the score rather than by a
# model. The UI says which path it used.
#
# Never commit a real key. Never paste one into source or into application.yml.
GEMINI_API_KEY=

# Which Gemini model to use. Defaults to gemini-2.5-flash.
# CAREERFLUX_AI_MODEL=gemini-2.5-flash


# --- Administrator account (optional) -----------------------------------------
#
# Set both to have the first administrator created on the next start. There is
# deliberately no default admin account: a fixed credential in the source would
# be a backdoor. The password must be at least 10 characters.
CAREERFLUX_ADMIN_EMAIL=
CAREERFLUX_ADMIN_PASSWORD=
# CAREERFLUX_ADMIN_NAME=CareerFlux Operator


# --- Database -----------------------------------------------------------------
#
# The `dev` profile uses a file-backed H2 database in PostgreSQL compatibility
# mode and needs none of this. These apply to the `postgres` profile.
# DATABASE_URL=jdbc:postgresql://localhost:5432/careerflux
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres


# --- Kafka (optional) ---------------------------------------------------------
#
# Only used with the `kafka` profile. Without it the ingestion pipeline runs its
# events through the in-process transactional outbox instead, using the same
# topic names and the same handlers.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# --- Other --------------------------------------------------------------------

# SERVER_PORT=8080
# CAREERFLUX_CORS_ORIGINS=http://localhost:5173
# CAREERFLUX_RESUME_DIR=./data/resumes
